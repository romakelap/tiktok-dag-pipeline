# ============================================================
# Echotik Pipeline — Environment Variables (Hetzner)
# ============================================================
# CARA PAKAI:
#   cp .env.hetzner.example .env
#   Isi semua nilai yang ada tanda <...>
# ============================================================

# ─── Airflow ────────────────────────────────────────────────
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.

# Generate dengan:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=<hasil_generate_fernet_key>

# Generate dengan:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=<hasil_generate_jwt_secret>

# Login Airflow UI
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=<password_airflow_ui_kamu>

# ─── PostgreSQL (Airflow metadata DB) ───────────────────────
POSTGRES_PASSWORD=<password_postgres>

# ─── MySQL (Application DB — tiktok_oltp) ───────────────────
MYSQL_ROOT_PASSWORD=<password_root_mysql>
MYSQL_PASSWORD=<password_user_echotik>
