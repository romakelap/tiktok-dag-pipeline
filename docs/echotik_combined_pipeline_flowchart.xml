<mxCell id="int2" value="DATA HAND-OFF 2&lt;br/&gt;MySQL tiktok_oltp: vw_ml_feature_store (22 fitur + nlp_text per video) | tracked_accounts (user aktif)&lt;br/&gt;hashtags_echotik + bi_hashtag_revenue_summary + hashtag_trending_history | video_metrics_snapshot (historis LSTM)&lt;br/&gt;Trigger: Manual via Airflow UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2C3E50;fontColor=#FFFFFF;strokeColor=#2C3E50;align=center;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="1446" width="1040" height="65" as="geometry"/></mxCell>
